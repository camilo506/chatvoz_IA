
#Voz de Sevino (solo en tu maquina).
[voice]
	#true = descargar y reproducir voz MP3 (internet).
	#false = solo narrador de Minecraft (activa Accesibilidad > Narrador o Ctrl+B).
	downloadVoiceMp3 = true
	#Voz preferida StreamElements (kappa v2/v3). Masculinas español: Pedro, Sergio, Andres, Enrique, Miguel.
	#El mod reintenta otras masculinas si la tuya falla.
	streamElementsVoice = "Miguel"
	#Idioma del respaldo Google si StreamElements falla (solo si useGoogleTtsFallback=true).
	#Con es se prueba es-us y luego es.
	googleTtsLang = "es"
	#false = nunca usar Google TTS (evita voz femenina tipica del respaldo).
	#true = si StreamElements falla del todo, usar Google (puede sonar a mujer).
	useGoogleTtsFallback = false

